{
	"name": "architecture-to-c4",
	"version": "0.1.0",
	"private": true,
	"description": "Generate Structurizr DSL from structured architecture Markdown.",
	"license": "GPL-2.0-or-later",
	"scripts": {
		"build": "rm -rf dist && tsc",
		"typecheck": "tsc --noEmit",
		"test": "npm run build && node --test dist/*.test.js",
		"pregenerate": "npm run build",
		"generate": "node dist/generate-structurizr.js",
		"prevalidate": "npm run build",
		"validate": "node dist/validate-structurizr-cli.js"
	},
	"devDependencies": {
		"@types/node": "20.17.10",
		"markdown-it": "14.3.2",
		"typescript": "^6.0.3"
	}
}
